{
  "name": "zen-course-hub",
  "version": "0.1.0",
  "private": true,
  "description": "ZEN大学向けの非公式履修計画・卒業要件確認ツール",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build-public.cjs",
    "qa:exam": "node scripts/qa/exam-feedback.cjs",
    "qa:map": "node scripts/qa/curriculum-map.cjs",
    "dev": "node scripts/dev-server.cjs",
    "check": "npm run lint && npm run format:check && npm run build && npm run test:coverage",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"src/domain/**/*.js\" --test-coverage-include=\"graduation-requirements.js\" --test-coverage-include=\"simulator-rules.js\" --test-coverage-include=\"quality-utils.js\" --test-coverage-include=\"exam-schedule.js\" --test-coverage-include=\"course-sorting.js\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=95 --test tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10"
  },
  "type": "commonjs"
}
